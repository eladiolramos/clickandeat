POSTGRES_DB=write_your_dbName
POSTGRES_USER=write_your_userName
POSTGRES_PASSWORD=write_your_userPassword
DB_HOST_PORT=write_your_hostPort
# Host de PostgreSQL visto desde el backend.
# 127.0.0.1 en desarrollo local; en Docker será el nombre del servicio; en la nube, el host del proveedor.
DB_HOST=127.0.0.1
